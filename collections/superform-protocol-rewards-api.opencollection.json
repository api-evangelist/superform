{
  "opencollection": "1.0.0",
  "info": {
    "name": "Superform Auxiliary Protocol Rewards API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Protocol Rewards",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get transaction for claiming rewards",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.superform.xyz/protocolRewards/claim/:chain_id/:user",
            "params": [
              {
                "name": "user",
                "value": "0x1234567890123456789012345678901234567890",
                "type": "path"
              },
              {
                "name": "chain_id",
                "value": "1",
                "type": "path"
              },
              {
                "name": "simulate_transaction",
                "value": "false",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "SF-API-KEY",
              "value": "{{SF-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Get transaction for claiming rewards for a user"
        },
        {
          "info": {
            "name": "Get claimable rewards",
            "type": "http"
          },
          "http": {
