              },
              {
                "name": "contract_address",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "SF-API-KEY",
              "value": "{{SF-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Get the vault type of a contract address (ERC4626, ERC5115, ERC7540)"
        }
      ]
    }
  ],
  "bundled": true
